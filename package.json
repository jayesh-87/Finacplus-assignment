{
  "name": "demoqa-playwright-qa",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright automation for the demoqa Book Store assignment",
  "type": "module",
  "imports": {
    "#fixtures/*": "./fixtures/*",
    "#helpers/*": "./helpers/*",
    "#test-data/*": "./test-data/*",
    "#utils/*": "./utils/*"
  },
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --project=chromium",
    "test:api": "playwright test --project=reqres",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "report": "playwright show-report",
    "clean": "rimraf playwright-report test-results output",
    "lint": "biome lint .",
    "check": "biome check ."
  },
  "author": "Jayesh Solanke",
  "license": "MIT",
  "dependencies": {
    "dotenv": "^17.2.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "^1.64.1",
    "rimraf": "^5.0.5"
  }
}
